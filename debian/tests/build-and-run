#!/bin/sh
# Smoke test: compile a small program against the installed libscifor-dev
# using only pkg-config, link it, run it and check the numerical results.
set -eu

cd "${AUTOPKGTEST_TMP:-$(mktemp -d)}"

cat > smoke.f90 <<'F90'
program smoke
  use scifor
  implicit none
  integer,parameter :: L=1000,N=4
  real(8)           :: x(L),f(L),dh,integral
  real(8)           :: A(N,N),B(N,N)
  integer           :: i,fails

  fails = 0

  ! SF_ARRAYS + SF_INTEGRATE: int_0^1 sqrt(x) dx = 2/3
  x = linspace(0d0,1d0,L,mesh=dh)
  f = sqrt(x)
  integral = simps(f,dh)
  if(abs(integral-2d0/3d0) > 1d-4)then
     write(*,*)"FAIL simps",integral
     fails = fails + 1
  endif

  ! SF_CONSTANTS
  if(abs(pi-acos(-1d0)) > 1d-14)then
     write(*,*)"FAIL pi",pi
     fails = fails + 1
  endif

  ! SF_LINALG (LAPACK): invert a diagonally dominant matrix, check A*A^-1 = 1
  do i=1,N
     A(i,:) = 1d0
     A(i,i) = dble(N+i)
  enddo
  B = A
  call inv(B)
  if(maxval(abs(matmul(A,B)-eye(N))) > 1d-12)then
     write(*,*)"FAIL inv"
     fails = fails + 1
  endif

  if(fails /= 0) stop 1
  write(*,*)"scifor smoke test OK"
end program smoke
F90

echo "pkg-config flags:"
pkg-config --cflags --libs scifor

# The .mod files are only readable by the gfortran they were built for.
mpif90 -cpp -ffree-line-length-none smoke.f90 -o smoke \
    $(pkg-config --cflags scifor) $(pkg-config --libs scifor)
./smoke
