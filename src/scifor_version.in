MODULE SF_VERSION
  implicit none

  !GIT VERSION
  character(len=41),parameter,public :: scifor_version_sha1 = "@GIT_SHA1@" !SHA1 of the git commit of this SciFortran version

contains

  !+-------------------------------------------------------------------+
  !PURPOSE  : print actual version of the software (if any)
  !+-------------------------------------------------------------------+
  subroutine scifor_version()
  !This subroutine prints the version of the SciFortran library, i.e. the git SHA1 stored in :f:var:`scifor_version_sha1`, and
  !the current timestamp to the standard output: :code:`SCIFOR VERSION (GIT): sha1` and
  !:code:`Timestamp: + d Month yyyy h:mm:ss.mmm`. The same lines are written to the file :code:`scifor_version.inc` in the
  !current directory, overwriting it.
  !
    integer(4),dimension(8)                  :: dummy
    integer(4)                               :: year
    integer(4)                               :: mese
    integer(4)                               :: day
    integer(4)                               :: h
    integer(4)                               :: m
    integer(4)                               :: s
    integer(4)                               :: ms
    character(len=9),parameter,dimension(12) :: month = (/ &
         'January  ', 'February ', 'March    ', 'April    ', &
         'May      ', 'June     ', 'July     ', 'August   ', &
         'September', 'October  ', 'November ', 'December ' /)
    write(*,"(A)")("SCIFOR VERSION (GIT): "//trim(adjustl(trim(scifor_version_sha1))))
    call date_and_time(values=dummy)
    year = dummy(1)
    mese = dummy(2)
    day  = dummy(3)
    h    = dummy(5)
    m    = dummy(6)
    s    = dummy(7)
    ms   = dummy(8)
    write(*,"(A,i2,1x,a,1x,i4,2x,i2,a1,i2.2,a1,i2.2,a1,i3.3)")&
         "Timestamp: +",day,trim(month(mese)),year, h,':',m,':',s,'.',ms
    write(*,*)""
    open(10,file="scifor_version.inc")
    write(10,"(A)")"SCIFOR VERSION (GIT): "//trim(adjustl(trim(scifor_version_sha1)))
    write(10,"(A,i2,1x,a,1x,i4,2x,i2,a1,i2.2,a1,i2.2,a1,i3.3)")&
         "Timestamp: +",day,trim(month(mese)),year, h,':',m,':',s,'.',ms
    write(10,*)""
    close(10)
  end subroutine scifor_version


  subroutine code_version(revision,name,git)
  !This subroutine prints the version of a code and the current timestamp to the standard output, as
  !:code:`NAME VERSION (GIT): revision` and :code:`Timestamp: + d Month yyyy h:mm:ss.mmm`. The same lines are written to the
  !file :code:`NAME_version.inc` in the current directory, overwriting it. It is the generalization of
  !:f:func_inline:`scifor_version` to any code.
  !
    character(len=*)                         :: revision  ! version of the code, e.g. the git SHA1
    character(len=*),optional                :: name      ! optional: name of the code, default 'code'
    character(len=100)                       :: name_
    integer(4),dimension(8)                  :: dummy
    logical,optional                         :: git       ! optional: .true. (default) GIT label, .false. plain VERSION
    logical                                  :: git_
    integer(4)                               :: year
    integer(4)                               :: mese
    integer(4)                               :: day
    integer(4)                               :: h
    integer(4)                               :: m
    integer(4)                               :: s
    integer(4)                               :: ms
    character(len=9),parameter,dimension(12) :: month = (/ &
         'January  ', 'February ', 'March    ', 'April    ', &
         'May      ', 'June     ', 'July     ', 'August   ', &
         'September', 'October  ', 'November ', 'December ' /)
    name_="code";if(present(name))name_=(trim(adjustl(trim(name))))
    
    git_ = .true.
    if(present(git))git_ = git
    
    if (git_)then
      write(*,"(A)")(trim(name_)//" VERSION (GIT): "//trim(adjustl(trim(revision))))
    else
      write(*,"(A)")(trim(name_)//" VERSION: "//trim(adjustl(trim(revision))))
    endif
    call date_and_time(values=dummy)
    year = dummy(1)
    mese = dummy(2)
    day  = dummy(3)
    h    = dummy(5)
    m    = dummy(6)
    s    = dummy(7)
    ms   = dummy(8)
    write(*,"(A,i2,1x,a,1x,i4,2x,i2,a1,i2.2,a1,i2.2,a1,i3.3)")&
         "Timestamp: +",day,trim(month(mese)),year, h,':',m,':',s,'.',ms
    write(*,*)""
    open(10,file=trim(name_)//"_version.inc")
    if (git_)then
      write(10,"(A)")trim(name_)//" VERSION (GIT): "//trim(adjustl(trim(revision)))
    else
      write(10,"(A)")trim(name_)//" VERSION: "//trim(adjustl(trim(revision)))
    endif
    write(10,"(A,i2,1x,a,1x,i4,2x,i2,a1,i2.2,a1,i2.2,a1,i3.3)")&
         "Timestamp: +",day,trim(month(mese)),year, h,':',m,':',s,'.',ms
    write(10,*)""
    close(10)
  end subroutine code_version

END MODULE SF_VERSION
